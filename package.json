{
  "name": "telegram-email-drafting-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "telegram:owner-id": "node scripts/get-telegram-owner-id.mjs",
    "telegram:set-webhook": "node scripts/register-telegram-webhook.mjs",
    "google:setup": "node scripts/google-setup.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.jsonc\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.jsonc\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250917.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "wrangler": "4.38.0"
  }
}
